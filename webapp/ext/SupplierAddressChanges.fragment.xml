<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">
    <l:Grid defaultSpan="XL4 L4 M6 S12" hSpacing="1" vSpacing="0" class="sapUiSmallMargin">
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgAddress}" editable="{ui>/isEditable}" tooltip="Tick to change" class="sapUiTinyMarginEnd"/>
            <Label text="Street" width="8rem"/>
            <Input value="{Street}" editable="{= ${ui>/isEditable} &amp;&amp; !!${ChgAddress}}" width="14rem"/>
        </HBox>
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgHouse}" editable="{ui>/isEditable}" tooltip="Tick to change" class="sapUiTinyMarginEnd"/>
            <Label text="House No." width="8rem"/>
            <Input value="{HouseNumber}" editable="{= ${ui>/isEditable} &amp;&amp; !!${ChgHouse}}" width="14rem"/>
        </HBox>
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgCity}" editable="{ui>/isEditable}" tooltip="Tick to change" class="sapUiTinyMarginEnd"/>
            <Label text="City" width="8rem"/>
            <Input value="{City}" editable="{= ${ui>/isEditable} &amp;&amp; !!${ChgCity}}" width="14rem"/>
        </HBox>
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgPostal}" editable="{ui>/isEditable}" tooltip="Tick to change" class="sapUiTinyMarginEnd"/>
            <Label text="Postal Code" width="8rem"/>
            <Input value="{PostalCode}" editable="{= ${ui>/isEditable} &amp;&amp; !!${ChgPostal}}" width="14rem"/>
        </HBox>
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgRegion}" editable="{ui>/isEditable}" tooltip="Tick to change" class="sapUiTinyMarginEnd"/>
            <Label text="State / Region" width="8rem"/>
            <Input value="{Region}" editable="{= ${ui>/isEditable} &amp;&amp; !!${ChgRegion}}" width="14rem"/>
        </HBox>
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgCountry}" editable="{ui>/isEditable}" tooltip="Tick to change" class="sapUiTinyMarginEnd"/>
            <Label text="Country" width="8rem"/>
            <Input value="{Country}" editable="{= ${ui>/isEditable} &amp;&amp; !!${ChgCountry}}" width="14rem"/>
        </HBox>
    </l:Grid>
</core:FragmentDefinition>