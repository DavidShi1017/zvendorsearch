{
  "_version": "1.65.0",
  "sap.app": {
    "id": "zvendorsearch",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.18.3",
      "toolsId": "15d9602b-9ba9-43e2-8b00-6ae6b7ecf840"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_vo_mysupplier_o4/srvd/sap/zui_vo_mysupplier/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zvendorsearch.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SupplierSearchList",
          "target": "SupplierSearchList"
        },
        {
          "pattern": "SupplierSearch({key}):?query:",
          "name": "SupplierSearchObjectPage",
          "target": "SupplierSearchObjectPage"
        },
        {
          "pattern": "VendorUpdateRequest({key}):?query:",
          "name": "VendorUpdateRequestObjectPage",
          "target": "VendorUpdateRequestObjectPage"
        }
      ],
      "targets": {
        "SupplierSearchList": {
          "type": "Component",
          "id": "SupplierSearchList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/SupplierSearch",
              "variantManagement": "Page",
              "navigation": {
                "SupplierSearch": {
                  "detail": {
                    "route": "SupplierSearchObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "SupplierSearchObjectPage": {
          "type": "Component",
          "id": "SupplierSearchObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/SupplierSearch",
              "content": {
                "header": {
                  "actions": {
                    "editSupplier": {
                      "press": "zvendorsearch.ext.SupplierEditHandler.onEditSupplier",
                      "visible": true,
                      "enabled": true,
                      "text": "{i18n>editSupplier}"
                    }
                  }
                }
              }
            }
          }
        },
        "VendorUpdateRequestObjectPage": {
          "type": "Component",
          "id": "VendorUpdateRequestObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/VendorUpdateRequest",
              "content": {
                "body": {
                  "sections": {
                    "SupplierChanges": {
                      "template": "zvendorsearch.ext.SupplierChanges",
                      "title": "Supplier Data",
                      "position": {
                        "placement": "After",
                        "anchor": "General"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
